<Project>
  <!--
    Windows AMD64 Profiler 只能与 Diagnostics 一起构建和部署。此目标不参与设计时构建，
    以免编辑器因本机缺少 CMake 或 Windows SDK 而阻塞。
  -->
  <PropertyGroup>
    <RetentionProfilerSourceDirectory>$([System.String]::Copy('$(MSBuildThisFileDirectory)').TrimEnd('\'))</RetentionProfilerSourceDirectory>
    <!-- NMake 是单配置生成器；按 Configuration 隔离缓存，避免 Debug/Release 并发改写同一个 CMakeCache。 -->
    <RetentionProfilerBuildDirectory>$(BaseIntermediateOutputPath)retention-profiler\$(Configuration)</RetentionProfilerBuildDirectory>
  </PropertyGroup>

  <Target Name="BuildRetentionProfiler"
          BeforeTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\eng\Build-RetentionProfiler.ps1&quot; -SourceDirectory &quot;$(RetentionProfilerSourceDirectory)&quot; -BuildDirectory &quot;$(RetentionProfilerBuildDirectory)&quot; -Configuration &quot;$(Configuration)&quot; -Architecture x64" />
    <ItemGroup>
      <RetentionProfilerNativeArtifact Include="$(RetentionProfilerBuildDirectory)\DotnetAnalysis.RetentionProfiler.dll" />
      <RetentionProfilerNativeArtifact Include="$(RetentionProfilerBuildDirectory)\DotnetAnalysis.RetentionProfilerController.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RetentionProfilerNativeArtifact)"
          DestinationFolder="$(OutDir)native\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
